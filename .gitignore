# ==========================================
# Secrets & credentials — never commit these
# ==========================================
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-secrets.yml
application-secrets.yaml
*.p12
*.pem
*.key
*.jks
*.keystore
*.pfx
secrets/
credentials/

# ==========================================
# Java / Maven
# ==========================================
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Maven wrapper (keep mvnw scripts, ignore downloaded wrapper jar)
.mvn/wrapper/maven-wrapper.jar

# ==========================================
# Spring Boot
# ==========================================
# Local override files (common pattern for dev secrets)
*-local.properties
*-local.yml
*-local.yaml

# ==========================================
# Node / React (frontend)
# ==========================================
node_modules/
frontend/build/
frontend/.env
frontend/.env.*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# IDEs
# ==========================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
!.vscode/extensions.json

# Eclipse
.eclipse/
.classpath
.project
.settings/

# ==========================================
# OS
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# App runtime output
# ==========================================
logs/
*.log
